# Copy to .env (gitignored) and fill in real values.
#   cp .env.example .env

# Cloudflare API token for programmatic DNS edits on jura.moe.
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Use the "Edit zone DNS" template, scope to jura.moe only.
# Permissions needed: Zone:Zone:Read + Zone:DNS:Edit
CLOUDFLARE_API_TOKEN=

# Optional: hardcode the zone id to skip a lookup roundtrip.
# Find it in the Cloudflare dashboard sidebar for the jura.moe zone,
# or curl 'https://api.cloudflare.com/client/v4/zones?name=jura.moe' \
#   -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" | jq '.result[0].id'
CLOUDFLARE_ZONE_ID=
