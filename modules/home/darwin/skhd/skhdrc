# Not yabai stuff
cmd - return : kitty --single-instance -d ~
# `cd ~` only seeds the FIRST invocation: kitten quick-access-terminal is a
# singleton — subsequent presses just toggle visibility on the existing shell,
# so cwd stays wherever the user last navigated to.
shift + cmd - return : cd ~ && kitten quick-access-terminal

# Swallow cmd-h so macOS can't hide the focused window out from under aerospace.
cmd - h : echo 'nope'

# Streaming clients need every key forwarded to the remote host.
.blacklist [
    "moonlight"
]
